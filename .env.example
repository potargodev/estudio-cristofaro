# ───────── Sitio ─────────
# Todas se leen en runtime: cambiarlas en Easypanel no requiere recompilar.
# URL pública del sitio, sin barra final (canonical, sitemap, robots, JSON-LD, mails).
# Staging: https://app.estudiocristofaro.com
SITE_URL=https://estudiocristofaro.com
# Staging: true → robots.txt "Disallow: /", meta noindex, header X-Robots-Tag y sitemap vacío.
# En producción dejarla vacía o en false.
SITE_NOINDEX=
# Estudio activo (slug de la tabla studios)
STUDIO_SLUG=cristofaro

# ───────── Base de datos (Postgres de Easypanel) ─────────
# Local con docker compose: postgres://cristofaro:cristofaro@localhost:5432/cristofaro
DATABASE_URL=postgres://usuario:contraseña@host:5432/base

# ───────── Login (Better Auth) ─────────
# Secreto largo y aleatorio. Generarlo con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL del sitio para el login (la misma que SITE_URL). Staging: https://app.estudiocristofaro.com
BETTER_AUTH_URL=https://estudiocristofaro.com
# Opcional: otros orígenes desde los que se permite iniciar sesión, separados por coma.
# Los de BETTER_AUTH_URL y SITE_URL ya están incluidos.
BETTER_AUTH_TRUSTED_ORIGINS=

# ───────── Google (login de clientes) ─────────
# OAuth de Google Cloud (ver README → "Acceso de clientes con Google").
# Sin las dos, el botón "Continuar con Google" no aparece y los clientes entran
# solo con el enlace por mail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SOLO PRUEBAS LOCALES: simuladores de Google (login y Calendar). Nunca en staging ni producción.
GOOGLE_OAUTH_MOCK_URL=
GOOGLE_API_MOCK_URL=

# ───────── Agenda (Google Calendar + Meet) ─────────
# Clave para cifrar (AES-256-GCM) los secretos guardados en la base: tokens de
# Google Calendar y Drive, claves de los proveedores de IA y credenciales de las
# conexiones (Xubio, MCP externos). Generarla con: openssl rand -base64 32.
# No cambiarla: habría que volver a cargar todas las claves y conexiones.
ENCRYPTION_KEY=
# Opcional: secreto para disparar los recordatorios desde un cron externo
# (POST /api/agenda/recordatorios con "Authorization: Bearer <CRON_SECRET>").
# Sin cron externo, la app los manda sola cada 5 minutos.
CRON_SECRET=
# "off" apaga los recordatorios automáticos internos (si se usa el cron externo).
AGENDA_REMINDERS=

# ───────── Archivos del portal de clientes ─────────
# Carpeta donde se guardan documentos y comprobantes. En Easypanel es un volumen
# montado en /data/uploads (valor por defecto). En desarrollo: una carpeta local.
UPLOADS_DIR=/data/uploads

# ───────── Primer usuario administrador (npm run db:seed) ─────────
ADMIN_EMAIL=
# Mínimo 8 caracteres. Cambiala o borrala de las variables después del primer seed.
ADMIN_PASSWORD=

# ───────── Mails (SMTP de la casilla del dominio) ─────────
# Usar el SMTP del proveedor donde está la casilla de estudiocristofaro.com:
# enviar desde otro servidor hace que los mails caigan en spam.
# Si falta alguna, la web funciona igual pero no envía mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=avisos@estudiocristofaro.com
SMTP_PASS=
# Remitente, ej: "Estudio Cristofaro <avisos@estudiocristofaro.com>" (tiene que ser la casilla de SMTP_USER)
MAIL_FROM=
# Dónde llegan los avisos de nuevas consultas
STUDIO_NOTIFY_EMAIL=contacto@estudiocristofaro.com

# ───────── F2 · Conexiones ─────────
# SOLO PRUEBAS LOCALES: API de Xubio simulada (mocks/xubio). Vacío = la API real (https://xubio.com/API/1.1).
XUBIO_API_URL=
