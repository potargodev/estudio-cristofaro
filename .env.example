# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://estudiocristofaro.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Estudio activo (slug de la tabla studios)
STUDIO_SLUG=cristofaro

# Resend (mails de consultas). Si queda vacío, no se envían mails.
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "Estudio Cristofaro <avisos@estudiocristofaro.com>"
RESEND_FROM=
# Dónde llegan los avisos de nuevas consultas
STUDIO_NOTIFY_EMAIL=contacto@estudiocristofaro.com
