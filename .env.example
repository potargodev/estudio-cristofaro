# ───────── Sitio ─────────
# Todas se leen en runtime: cambiarlas en Easypanel no requiere recompilar.
# URL pública del sitio, sin barra final (canonical, sitemap, robots, JSON-LD, mails).
# Staging: https://app.estudiocristofaro.com
SITE_URL=https://estudiocristofaro.com
# Staging: true → robots.txt "Disallow: /", meta noindex, header X-Robots-Tag y sitemap vacío.
# En producción dejarla vacía o en false.
SITE_NOINDEX=
# Estudio activo (slug de la tabla studios)
STUDIO_SLUG=cristofaro

# ───────── Base de datos (Postgres de Easypanel) ─────────
# Local con docker compose: postgres://cristofaro:cristofaro@localhost:5432/cristofaro
DATABASE_URL=postgres://usuario:contraseña@host:5432/base

# ───────── Login (Better Auth) ─────────
# Secreto largo y aleatorio. Generarlo con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL del sitio para el login (la misma que SITE_URL). Staging: https://app.estudiocristofaro.com
BETTER_AUTH_URL=https://estudiocristofaro.com
# Opcional: otros orígenes desde los que se permite iniciar sesión, separados por coma.
# Los de BETTER_AUTH_URL y SITE_URL ya están incluidos.
BETTER_AUTH_TRUSTED_ORIGINS=

# ───────── Google (login de clientes) ─────────
# OAuth de Google Cloud (ver README → "Acceso de clientes con Google").
# Sin las dos, el botón "Continuar con Google" no aparece y los clientes entran
# solo con el enlace por mail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SOLO PRUEBAS LOCALES: simuladores de Google (login y Calendar). Nunca en staging ni producción.
GOOGLE_OAUTH_MOCK_URL=
GOOGLE_API_MOCK_URL=

# ───────── Agenda (Google Calendar + Meet) ─────────
# Clave para cifrar (AES-256-GCM) los secretos guardados en la base: tokens de
# Google Calendar y Drive, claves de los proveedores de IA y credenciales de las
# conexiones (Xubio, MCP externos). Generarla con: openssl rand -base64 32.
# No cambiarla: habría que volver a cargar todas las claves y conexiones.
ENCRYPTION_KEY=

# ───────── Archivos del portal de clientes ─────────
# Carpeta donde se guardan documentos y comprobantes. En Easypanel es un volumen
# montado en /data/uploads (valor por defecto). En desarrollo: una carpeta local.
UPLOADS_DIR=/data/uploads

# ───────── Primer usuario administrador (npm run db:seed) ─────────
ADMIN_EMAIL=
# Mínimo 8 caracteres. Cambiala o borrala de las variables después del primer seed.
ADMIN_PASSWORD=

# ───────── Mails (SMTP de la casilla del dominio) ─────────
# Usar el SMTP del proveedor donde está la casilla de estudiocristofaro.com:
# enviar desde otro servidor hace que los mails caigan en spam.
# Si falta alguna, la web funciona igual pero no envía mails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=avisos@estudiocristofaro.com
SMTP_PASS=
# Remitente, ej: "Estudio Cristofaro <avisos@estudiocristofaro.com>" (tiene que ser la casilla de SMTP_USER)
MAIL_FROM=
# Dónde llegan los avisos de nuevas consultas
STUDIO_NOTIFY_EMAIL=contacto@estudiocristofaro.com

# ───────── F2 · Conexiones ─────────
# SOLO PRUEBAS LOCALES: API de Xubio simulada (mocks/xubio). Vacío = la API real (https://xubio.com/API/1.1).
XUBIO_API_URL=

# ── Faro ──
# Dominios (separados por coma) que muestran la landing de Faro en "/" (en staging vive en /faro).
FARO_HOSTS=
# Dominios propios de los estudios (marca blanca): en esos hosts se sirve solo el portal.
# Los dominios verificados desde Configuración → Avanzado se suman solos.
APP_HOSTS=
# Email de contacto que muestra la landing de Faro.
FARO_CONTACT_EMAIL=
# Owner de la plataforma (Faro Manager) que configura el seed. Por defecto cristofaro.dev@gmail.com.
FARO_OWNER_EMAIL=cristofaro.dev@gmail.com
# Gastos compartidos: cotizaciones (formato DolarApi; por defecto https://dolarapi.com).
FX_API_URL=
# Mercado Pago (prueba): URL base de los links de pago simulados. La integración real llega en la F7.
MERCADOPAGO_MOCK_URL=

# ───────── ARCA (F3 · facturación y padrón por web services oficiales) ─────────
# El certificado y la clave de la CUIT que opera Faro se cargan en el Faro
# Manager (Plataforma → ARCA), cifrados con ENCRYPTION_KEY. Estas variables
# solo pisan las URLs oficiales, para apuntar al simulador (mocks/arca):
#   node mocks/arca/server.mjs   →   http://localhost:4060
# NUNCA en staging ni producción.
ARCA_WSAA_URL=
ARCA_WSFE_URL=
ARCA_PADRON_URL=
ARCA_WSCDC_URL=

# ───────── Bitácora (F8 · conexiones Plus) ─────────
# Mercado Pago (OAuth de la aplicación de Faro): https://www.mercadopago.com.ar/developers/panel/app
# Redirect: <SITE_URL>/api/bitacora/conexiones/mercadopago/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Solo pruebas: el simulador (node mocks/mercadopago/server.mjs → http://localhost:4070)
MERCADOPAGO_API_URL=
MERCADOPAGO_AUTH_URL=
# Gmail usa GOOGLE_CLIENT_ID/SECRET (scope gmail.readonly, requiere verificación de Google).
# Redirect: <SITE_URL>/api/bitacora/conexiones/gmail/callback

# ───────── Cobros (F7 · Mercado Pago) ─────────
# La cuenta de Faro (cobra las suscripciones) se carga en Faro Manager →
# Plataforma → Mercado Pago (cifrada). Alternativa por variables:
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Webhooks: <SITE_URL>/api/mercadopago/webhook?cuenta=faro (cada estudio ve su URL en Honorarios → Configuración).
# Solo pruebas: el simulador firma los webhooks con este secreto (mocks/mercadopago).
MP_MOCK_WEBHOOK_SECRET=

# ───────────── WhatsApp (F9 · Meta Cloud API) ─────────────
# Las cuentas (la de Faro y las de cada estudio) se cargan en la app, cifradas.
# SOLO PRUEBAS LOCALES: el simulador (mocks/whatsapp). Vacío = https://graph.facebook.com/v21.0
WHATSAPP_API_URL=

# ───────────── Notificaciones push (PWA de Mensajes) ─────────────
# Claves VAPID. Si faltan, la app las genera una vez y las guarda cifradas en la base.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que reciben los servicios de push de los navegadores.
PUSH_CONTACT_EMAIL=

# ───────────── Tareas internas del contenedor ─────────────
# Cada tarea corre en una sola instancia a la vez (turno en la tabla job_leases),
# aunque haya más de un contenedor. "off" la apaga; <VARIABLE>_MS cambia la frecuencia.
# Para usar un cron externo: apagarla acá y llamar a su ruta con
# "Authorization: Bearer <CRON_SECRET>" (comparte el mismo turno, no duplica envíos).
#   AGENDA_REMINDERS  cada 5 min   recordatorios de llamadas    POST /api/agenda/recordatorios
#   GASTOS_JOBS       cada hora    recurrentes y recordatorios  POST /api/gastos/cron
#   COPILOT_JOBS      cada minuto  cola y recordatorios Vigía   POST /api/copiloto/cron
#   FLOWS_JOBS        cada minuto  motor de flujos (+ escaneo cada hora)  POST /api/flujos/cron[?escaneo=1]
#   ARCA_JOBS         cada hora    calendario personal y chequeos guiados
#   BITACORA_JOBS     cada hora    MEP, fijos, fugas, avisos, resumen del domingo y sueldo del dueño
#   COBROS_JOBS       cada hora    firmas de recibos, suscripciones y honorarios
#   TANGO_JOBS        cada 15 min  bandeja de salida y sondeo de Tango
#   AGENT_JOBS        cada 30 s    cola del Agente contable y sus rutinas
#   READ_JOBS         cada 30 s    cola de la carga masiva de comprobantes
# JOBS=off apaga todas (por ejemplo en una réplica que solo atiende pedidos).
CRON_SECRET=
JOBS=
AGENDA_REMINDERS=
GASTOS_JOBS=
COPILOT_JOBS=
FLOWS_JOBS=
ARCA_JOBS=
BITACORA_JOBS=
COBROS_JOBS=
TANGO_JOBS=
AGENT_JOBS=
READ_JOBS=

# ───────────── SOLO PRUEBAS LOCALES ─────────────
# Deja que las URLs que eligen los tenants (IA compatible, MCP externo, Tango)
# apunten a localhost y redes privadas, para usar los simuladores de mocks/.
# NUNCA en staging ni producción: abre la red interna del servidor (SSRF).
ALLOW_PRIVATE_URLS=
