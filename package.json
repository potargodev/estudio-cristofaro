{
  "name": "estudio-cristofaro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "reset-password": "tsx --env-file-if-exists=.env.local scripts/reset-password.ts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts scripts/reset-password.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "^15.5.0",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
