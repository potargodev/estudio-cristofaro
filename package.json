{
  "name": "estudio-cristofaro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/ayuda.mjs && node scripts/legal.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "ayuda": "node scripts/ayuda.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo.ts",
    "demo:seed": "tsx --env-file-if-exists=.env.local scripts/demo.ts seed",
    "demo:reset": "tsx --env-file-if-exists=.env.local scripts/demo.ts reset",
    "reset-password": "tsx --env-file-if-exists=.env.local scripts/reset-password.ts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts scripts/reset-password.ts scripts/faro-equipo.ts scripts/demo.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "faro-equipo": "tsx --env-file-if-exists=.env.local scripts/faro-equipo.ts",
    "test": "tsx --test src/modules/gastos/core/*.test.ts src/modules/*/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/azure": "^4.0.99",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/react": "^4.0.140",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.3.6",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "^15.5.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "write-excel-file": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "knip": "^5.88.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
